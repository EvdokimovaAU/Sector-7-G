      m_Calls: []
  m_text: "80\u2013100% \u2014 \u043F\u0430\u043D\u0435\u043B\u044C \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u0430.\n\n60\u201379%
    \u2014 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u044B \u0441\u043C\u0435\u0449\u0435\u043D\u044B
    \u043D\u0430 1; \u043D\u0430\u0441\u043E\u0441\u044B \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B
    \u0438\u043B\u0438 \u0441\u043C\u0435\u0449\u0435\u043D\u044B; \u0441\u0435\u043A\u0446\u0438\u0438
    \u0440\u0435\u0430\u043A\u0442\u043E\u0440\u0430 \u0441\u043C\u0435\u0449\u0435\u043D\u044B
    \u043D\u0430 1\u20132 \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u0432 \u043B\u044E\u0431\u0443\u044E
    \u0441\u0442\u043E\u0440\u043E\u043D\u0443.\n\n40\u201359% \u2014 \u2191/\u2193
    \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B, \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0438 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438 \u0438\u043D\u0432\u0435\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u044B;
    \u0412\u041A\u041B/\u0412\u042B\u041A\u041B \u0442\u0443\u0440\u0431\u0438\u043D
    \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u043D\u044B; Reset \u2194 \u043F\u043E\u0434\u0430\u0447\u0430
    \u0432\u043E\u0434\u044B.\n\n0\u201339% \u2014 \u2191/\u2193 \u043A\u043B\u0430\u043F\u0430\u043D\u043E\u0432
    \u0438\u043D\u0432\u0435\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u044B."
